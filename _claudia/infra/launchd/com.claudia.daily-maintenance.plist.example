<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claudia.daily-maintenance</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/edgar/Documents/000 Files/_claudia/infra/daily_maintenance.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/edgar/Documents/000 Files</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/edgar/Documents/000 Files/_claudia/infra/logs/launchd_daily_maintenance.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/edgar/Documents/000 Files/_claudia/infra/logs/launchd_daily_maintenance.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
