# Copy this file to .env.local and paste your SimpleFIN access URL there.
# Keep .env.local private. It is ignored by git.
SIMPLEFIN_ACCESS_URL=""

# Optional: if you only have a one-time setup token, paste it here and use
# the dashboard's "Claim setup token" action once. The server will print the
# returned access URL so you can move it into SIMPLEFIN_ACCESS_URL.
SIMPLEFIN_SETUP_TOKEN=""
